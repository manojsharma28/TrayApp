<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TrayApp.UI.Views.TrayMenuWindow"
        Width="360"
        Height="640"
        Background="{DynamicResource PageBackgroundBrush}"
        ShowInTaskbar="False"
        SystemDecorations="None"
        CanResize="False"
        Topmost="True"
        ShowActivated="True"
        WindowStartupLocation="Manual">
  <Window.Styles>
          <Style Selector="Button.menu-action">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="4"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
              </Setter>
          </Style>
          <Style Selector="Button.menu-action:pointerover">
            <Setter Property="Background" Value="{DynamicResource ActionHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
          </Style>
          <Style Selector="Button.menu-action:pressed">
            <Setter Property="Background" Value="{DynamicResource ActionPressedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
          </Style>
          <Style Selector="Button.menu-action:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
          </Style>
          <Style Selector="Button.menu-action:pressed TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
          </Style>
  </Window.Styles>

  <Border Background="{DynamicResource PanelBackgroundBrush}"
          BorderBrush="{DynamicResource PanelBorderBrush}"
          BorderThickness="1"
          CornerRadius="12"
          Padding="12">
    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
      <Grid ColumnDefinitions="*,Auto" Margin="6,4,6,8">
        <StackPanel Spacing="3">
          <TextBlock Text="AppHive"
                     FontSize="10"
                     FontWeight="Bold"
                     Foreground="{DynamicResource AccentBrush}"
                     LetterSpacing="1.5" />
          <TextBlock Text="Managed applications"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
        </StackPanel>
        <TextBlock Grid.Column="1"
                   Text="ONLINE"
                   VerticalAlignment="Center"
                   FontSize="10"
                   FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}"
                   LetterSpacing="1" />
      </Grid>

      <Border Grid.Row="1"
              Background="{DynamicResource InputBackgroundBrush}"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="6"
          MinHeight="0"
              Margin="0,0,0,8">
        <ScrollViewer MinHeight="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Name="AppItemsPanel" Spacing="2" Margin="0,0,20,0" />
        </ScrollViewer>
      </Border>

      <Border Grid.Row="2" Height="1" Background="{DynamicResource PanelBorderBrush}" Margin="4,2,4,8" />

      <Button Grid.Row="3" Name="SettingsButton"
              Classes="menu-action accent"
              Content="Manage applications" />
      <Button Grid.Row="4" Name="ExitButton"
              Classes="menu-action accent"
              Content="Quit AppHive" />
    </Grid>
  </Border>
</Window>