<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TrayApp.UI.Views.TrayMenuWindow"
        Width="320"
        Background="{DynamicResource PageBackgroundBrush}"
        ShowInTaskbar="False"
        SystemDecorations="None"
        CanResize="False"
        Topmost="True"
        ShowActivated="True"
        WindowStartupLocation="Manual">
  <Window.Styles>
    <Style Selector="Button.menu-action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.menu-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource PanelBorderBrush}" />
    </Style>
    <Style Selector="Button.menu-action.accent">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Styles>

  <Border Background="{DynamicResource PanelBackgroundBrush}"
          BorderBrush="{DynamicResource PanelBorderBrush}"
          BorderThickness="1"
          CornerRadius="12"
          Padding="12">
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="*,Auto" Margin="6,4,6,8">
        <StackPanel Spacing="3">
          <TextBlock Text="TRAYAPPMANAGER"
                     FontSize="10"
                     FontWeight="Bold"
                     Foreground="{DynamicResource AccentBrush}"
                     LetterSpacing="1.5" />
          <TextBlock Text="Managed applications"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
        </StackPanel>
        <TextBlock Grid.Column="1"
                   Text="ONLINE"
                   VerticalAlignment="Center"
                   FontSize="10"
                   FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}"
                   LetterSpacing="1" />
      </Grid>

      <Border Background="{DynamicResource InputBackgroundBrush}"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="6">
        <StackPanel Name="AppItemsPanel" Spacing="2" />
      </Border>

      <Border Height="1" Background="{DynamicResource PanelBorderBrush}" Margin="4,2" />

      <Button Name="SettingsButton"
              Classes="menu-action accent"
              Content="Open settings" />
      <Button Name="ExitButton"
              Classes="menu-action"
              Content="Quit TrayAppManager" />
    </StackPanel>
  </Border>
</Window>