<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TrayApp.UI.Views.SettingsWindow"
        Title="TrayApp Settings"
        Width="400" Height="300">
  <StackPanel Margin="12">
    <TextBlock Text="Settings" FontSize="18" />
    <TextBlock Text="ZeroMQ Endpoints" Margin="0,12,0,0" />
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="Pub:" Width="40" />
      <TextBox Name="PubEndpoint" Width="300" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
      <TextBlock Text="Sub:" Width="40" />
      <TextBox Name="SubEndpoint" Width="300" />
    </StackPanel>
    <Button Name="SaveButton" Content="Save" HorizontalAlignment="Right" Margin="0,12,0,0" />
  </StackPanel>
</Window>
